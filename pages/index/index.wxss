.top_search {
    background: #f7f7f7;
    border-radius: 30rpx 0 0 30rpx;
    color: #999;
    font-size: 30rpx;
    height: 60rpx;
    line-height: 60rpx;
    margin-left: 10rpx
}

.top_search.search-wx {
    -webkit-flex: 1;
    flex: 1
}

.top_search.special {
    border-right: none;
    width: 100%
}

.top_search_right {
    background: #f7f7f7;
    border: none;
    border-radius: 0 30rpx 30rpx 0;
    box-sizing: border-box;
    height: 60rpx;
    position: relative
}

.top_search_right:before {
    background-color: #999;
    bottom: 0;
    content: " ";
    height: 20rpx;
    left: 0;
    margin: auto;
    position: absolute;
    top: 0;
    width: 1rpx
}

.top_search_right .icon-saoyisao1 {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    padding: 0 20rpx
}

.top_search .icon-sousuo {
    color: #999;
    font-size: 30rpx;
    margin-left: 20rpx;
    margin-right: 10rpx
}

.top_bg {
    position: absolute;
    top: 0;
    z-index: 0
}

.top_bg,.top_bg wx-image {
    height: 350rpx;
    width: 750rpx
}

