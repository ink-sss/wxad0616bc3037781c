.collection-box {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 16rpx;
    box-shadow: 0 0 6rpx rgba(0,0,0,.08);
    font-size: 24rpx;
    line-height: 40rpx;
    padding: 20rpx;
    position: fixed;
    right: 20rpx;
    top: 20rpx;
    width: 380rpx;
    z-index: 100
}

.collection-box:after {
    background: #fff;
    border-left: 1px solid #eee;
    border-top: 1px solid #eee;
    content: "";
    display: block;
    height: 30rpx;
    position: absolute;
    right: 140rpx;
    top: -15rpx;
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg);
    -webkit-transform: rotate;
    transform: rotate;
    width: 30rpx
}

.collection-box .point {
    color: #666;
    font-size: 60rpx;
    height: 20rpx;
    line-height: 0;
    width: 20rpx
}

.collection-box .point-big {
    font-size: 80rpx
}

.collection-box .close-btn {
    background: #fff;
    border-radius: 50%;
    color: #999;
    height: 40rpx;
    line-height: 30rpx;
    padding: 0;
    position: absolute;
    right: 10rpx;
    top: 10rpx;
    width: 40rpx
}

.follow-gzh {
    background: #fff;
