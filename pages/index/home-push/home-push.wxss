.home-push {
    border-radius: 20rpx;
    overflow: hidden;
    width: 100%
}

.home-push-bg {
    background: #fff;
    box-shadow: 0 0 30rpx rgba(0,0,0,.1)
}

.home-push .title {
    font-size: 30rpx;
    font-weight: 700;
    padding: 10rpx 20rpx;
    text-align: center
}

.home-push .des {
    color: #999;
    padding: 20rpx
}

.home-push .btns {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 20rpx
}

.home-push .btns wx-button {
    background: #e2231a;
    border-radius: 45rpx;
    font-size: 28rpx;
    height: 80rpx;
    line-height: 80rpx;
    padding: 0;
    width: 200rpx
}

.home-push-wrap .image-text .pic {
    height: 300rpx;
    width: 600rpx
}

.home-push-wrap .image-only .pic {
    height: 420rpx;
    width: 600rpx
}

.home-push .cuopon .cuopon-title {
    height: 250rpx;
    overflow: hidden;
    width: 600rpx
}

.home-push-wrap wx-image {
    height: 100%;
    width: 100%
}

.home-push .cuopon .list {
    padding: 20rpx
}

.home-push .cuopon .list .item {
    background: #fff9eb;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin-top: 20rpx
}

.home-push .cuopon .item .info {
    border: 1px solid #ffe4d8;
    border-radius: 16rpx;
    -webkit-flex: 1;
    flex: 1;
    padding: 20rpx
}

.home-push .cuopon .item .info .num {
    color: #e2231a
}

.home-push .cuopon .item .explan {
    -webkit-align-items: center;
    align-items: center;
    background: #ff553c;
    border: 1px solid #ffe4d8;
    border-left: 2px dashed #ffe4d8;
    border-radius: 16rpx;
    color: #fff;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 20rpx;
    position: relative;
    width: 120rpx
}

.home-push .cuopon .item .explan .name {
    color: #fff9eb;
    font-size: 30rpx
}

.home-push .cuopon .item .explan .sub {
    color: #ff9897
}

.home-push .cuopon .list .explan:after,.home-push .cuopon .list .explan:before {
    background: #fff;
    content: "";
    display: block;
    height: 10rpx;
    position: absolute;
    width: 20rpx
}

.home-push .cuopon .list .explan:before {
    border-radius: 0 0 10rpx 10rpx;
    left: -10rpx;
    top: -1px
}

.home-push .cuopon .list .explan:after {
    border-radius: 10rpx 10rpx 0 0;
    bottom: -1px;
    left: -10rpx
}

.home-push-wrap .close-btns {
    -webkit-align-items: center;
    align-items: center;
    background: none;
    border: 2px solid #fff;
    border-radius: 50%;
    display: -webkit-flex;
    display: flex;
    height: 60rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 50rpx auto 0;
    width: 60rpx
}

.home-push-wrap .close-btns .iconfont {
    color: #fff
}
