#footBottom {
    height: 94rpx;
    padding-bottom: env(safe-area-inset-bottom);
    width: 100%
}

.inner-tab {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    display: -webkit-flex;
    display: flex;
    height: 80rpx;
    -webkit-justify-content: space-around;
    justify-content: space-around;
    position: relative;
    z-index: 9
}

.inner-tab .item {
    color: #666;
    -webkit-flex: 1;
    flex: 1;
    font-size: 30rpx;
    height: 100%;
    line-height: 80rpx;
    position: relative
}

.inner-tab .item .box {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: center;
    justify-content: center
}

.inner-tab .item.active {
    color: #333
}

.inner-tab .item.active:after {
    border-radius: 3rpx;
    bottom: 0rpx;
    content: "";
    height: 5rpx;
    left: 0;
    margin: auto;
    position: absolute;
    right: 0;
    width: 42rpx
}

[data-theme=theme0] .inner-tab .item.active:after {
    background-color: #ff5704!important
}

[data-theme=theme1] .inner-tab .item.active:after {
    background-color: #19ad57!important
}

[data-theme=theme2] .inner-tab .item.active:after {
    background-color: #fc0!important
}

[data-theme=theme3] .inner-tab .item.active:after {
    background-color: #33a7ff!important
}

[data-theme=theme4] .inner-tab .item.active:after {
    background-color: #e4e4e4!important
}

[data-theme=theme5] .inner-tab .item.active:after {
    background-color: #c8ba97!important
}

[data-theme=theme6] .inner-tab .item.active:after {
    background-color: #623ceb!important
}

.butns {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 10rpx;
    color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    height: 60rpx;
    -webkit-justify-content: center;
    justify-content: center;
    white-space: nowrap;
    width: auto
}

.starts {
    display: block;
    height: 20rpx;
    margin-right: 10rpx;
    width: 20rpx
}

.starts-box {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    left: 0;
    position: absolute;
    top: 0;
    z-index: 1
}

.shop_list_page {
    box-sizing: border-box;
    padding: 0 20rpx
}

.shop-item {
    background-color: #fff;
    border-radius: 20rpx;
    box-sizing: border-box;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-top: 30rpx;
    padding: 20rpx
}

.shop-info-top,.shop-item {
    display: -webkit-flex;
    display: flex
}

.shop-info-top {
    -webkit-align-items: center;
    align-items: center;
    height: 100rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    width: 100%
}

.shop_logo {
    background-color: rgba(0,0,0,.1);
    border-radius: 15rpx;
    display: block;
    height: 100rpx;
    width: 100rpx
}

.shopinfo {
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    padding-left: 20rpx;
    padding-top: 0
}

.shop-item_shop_others,.shopinfo {
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex
}

.shop-item_shop_others {
    color: #333;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-size: 26rpx;
    padding: 0 10rpx 10rpx;
    text-align: right
}

.shop-item_shop_others,.shop-product {
    -webkit-justify-content: flex-start;
    justify-content: flex-start
}

.shop-product {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    margin-top: 18rpx;
    width: 100%
}

.shop-product-item {
    margin-right: 16rpx
}

.shop-pitem-image {
    background: #eee;
    border-radius: 15rpx;
    display: block;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    height: 210rpx;
    width: 210rpx
}

.sales {
    color: #585858
}

.collect {
    margin-bottom: 26rpx
}
