.top-box {
    left: 0;
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 10
}

.top-box .index-search-box_re {
    padding: 15rpx 20rpx
}

.top-box .index-search-box_re .index-search_re {
    background: #f8f8f8;
    border-radius: 36rpx;
    box-sizing: border-box;
    height: 72rpx;
    padding: 0 35rpx 0 32rpx
}

.top-box .index-search-box_re .index-search_re .icon-sousuo {
    color: #666;
    font-size: 26rpx
}

.top-tabbar {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-flex-wrap: nowrap;
    flex-wrap: nowrap;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    overflow: hidden;
    overflow-x: auto
}

.tab-item {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    -webkit-flex: auto;
    flex: auto;
    white-space: nowrap
}

.order-list {
    padding: 26rpx 20rpx
}

.order-list .item {
    background: #fff;
    border-radius: 15rpx;
    margin-bottom: 30rpx;
    padding: 30rpx
}

.order-list .item .order-head .state-text {
    border-radius: 8rpx;
    font-size: 22rpx;
    height: 36rpx;
    line-height: 36rpx;
    margin-right: 5rpx;
    padding: 0 10rpx
}

[data-theme=theme0] .order-list .item .order-head .state-text {
    background-color: #ff5704!important
}

[data-theme=theme1] .order-list .item .order-head .state-text {
    background-color: #19ad57!important
}

[data-theme=theme2] .order-list .item .order-head .state-text {
    background-color: #fc0!important
}

[data-theme=theme3] .order-list .item .order-head .state-text {
    background-color: #33a7ff!important
}

[data-theme=theme4] .order-list .item .order-head .state-text {
    background-color: #e4e4e4!important
}

[data-theme=theme5] .order-list .item .order-head .state-text {
    background-color: #c8ba97!important
}

[data-theme=theme6] .order-list .item .order-head .state-text {
    background-color: #623ceb!important
}

[data-theme=theme0] .order-list .item .order-head .state-text,[data-theme=theme1] .order-list .item .order-head .state-text,[data-theme=theme2] .order-list .item .order-head .state-text,[data-theme=theme3] .order-list .item .order-head .state-text,[data-theme=theme4] .order-list .item .order-head .state-text,[data-theme=theme5] .order-list .item .order-head .state-text,[data-theme=theme6] .order-list .item .order-head .state-text {
    color: #fff!important
}

.order-list .item .order-head .ddh {
    display: block
}

.order-list .one-product,.order-list .product-list {
    box-sizing: initial;
    height: 150rpx;
    padding: 30rpx 0 27rpx
}

.order-list .cover {
    border-radius: 8rpx;
    height: 150rpx;
    width: 150rpx
}

.order-list .total-count {
    -webkit-align-items: flex-end;
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    padding-left: 20rpx
}

.shop-name {
    color: #999;
    font-size: 24rpx;
    font-weight: 400
}

.one-product .pro-info {
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: #333;
    display: -webkit-box;
    font-size: 26rpx;
    overflow: hidden;
    padding: 0 21rpx 0 37rpx;
    width: 361rpx
}

.total-count .count {
    color: #999;
    font-size: 22rpx;
    padding-top: 16rpx
}

.product-list .total-count {
    background: hsla(0,0%,100%,.9);
    bottom: 0;
    position: absolute;
    right: 0;
    top: 0
}

.product-list .total-count .left-shadow {
    bottom: 0;
    left: -24rpx;
    overflow: hidden;
    position: absolute;
    top: 0;
    width: 24rpx
}

.product-list .total-count .left-shadow:after {
    background-image: radial-gradient(rgba(0,0,0,.2) 10%,rgba(0,0,0,.1) 40%,transparent 80%);
    bottom: 0;
    content: "";
    display: block;
    position: absolute;
    right: -12rpx;
    top: 0;
    width: 24rpx
}

.order-list .order-bts {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.order-list .order-bts.presale {
    display: block;
    padding-top: 12rpx
}

.order-list .order-bts wx-button {
    -webkit-align-items: center;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 30px;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    font-size: 24rpx;
    height: 52rpx;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 52rpx;
    margin: 0 0 0 12rpx;
    padding: 0 36rpx;
    white-space: nowrap
}

.order-list .order-bts wx-button:after {
    display: none
}

.item-dianpu {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    font-size: 24rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    line-height: 30rpx
}

.item-dianpu .icon-jiantou {
    color: #333;
    font-size: 24rpx
}

.item-d-l {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row
}

.icon-stores {
    color: #333;
    font-size: 32rpx;
    margin-right: 20rpx
}

.money-price {
    display: block
}

.order-box {
    background-color: #fff;
    border-radius: 20px 20px 0 0;
    height: 78vh;
    overflow-y: scroll
}

.d-b-c,.d-b-s,.d-s-c,.d-s-s,.index-search {
    -webkit-flex-direction: row;
    flex-direction: row
}

.search-box-top {
    -webkit-align-items: center;
    align-items: center;
    width: 100%
}

.tab-box {
    text-align: center
}

.active:after {
    left: calc(50% - 1rem)
}

.noOrder {
    text-align: center
}
