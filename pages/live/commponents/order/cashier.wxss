.icon-box .icon.iconfont.icon-xuanze {
    font-size: 36rpx
}

.buy-checkout-top {
    padding: 74rpx 0 64rpx
}

.buy-checkout {
    background-color: #fff;
    border-radius: 25rpx;
    margin: 0 24rpx
}

.buy-checkout .item {
    border-bottom: 1px solid #eee;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin: 0 20rpx;
    padding-left: 0;
    padding-right: 0
}

.buy-checkout .item:last-child {
    border: none
}

.bottom-btn {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 72rpx;
    bottom: 0;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    font-size: 30rpx;
    font-weight: 700;
    height: 96rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 20rpx;
    position: fixed;
    width: 710rpx
}

[data-theme=theme0] .bottom-btn {
    background-color: #ff5704!important
}

[data-theme=theme1] .bottom-btn {
    background-color: #19ad57!important
}

[data-theme=theme2] .bottom-btn {
    background-color: #fc0!important
}

[data-theme=theme3] .bottom-btn {
    background-color: #33a7ff!important
}

[data-theme=theme4] .bottom-btn {
    background-color: #e4e4e4!important
}

[data-theme=theme5] .bottom-btn {
    background-color: #c8ba97!important
}

[data-theme=theme6] .bottom-btn {
    background-color: #623ceb!important
}

[data-theme=theme0] .bottom-btn,[data-theme=theme1] .bottom-btn,[data-theme=theme2] .bottom-btn,[data-theme=theme3] .bottom-btn {
    color: #fff!important
}

[data-theme=theme4] .bottom-btn {
    color: #333!important
}

[data-theme=theme5] .bottom-btn,[data-theme=theme6] .bottom-btn {
    color: #fff!important
}

.key {
    font-size: 26rpx
}

.head-top {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 20rpx 20rpx 0 0;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 100rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    left: 0;
    padding: 0 30rpx;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 99
}

.head-top,.wrap {
    background-color: #fff
}

.wrap {
    border-radius: 20px 20px 0 0;
    height: 78vh;
    overflow-y: scroll;
    padding: 100rpx 20rpx 200rpx
}

.head-title {
    font-size: 28rpx
}

.head-option {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-flow: column;
    flex-flow: column;
    margin: 0 20rpx
}

.head-option .cart-pic {
    width: 45rpx
}

.head-option .order-pic {
    width: 40rpx
}

.head-option wx-text {
    font-size: 26rpx;
    margin-top: 5rpx
}

.pay-info {
    -webkit-align-items: center;
    align-items: center;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: center;
    justify-content: center
}
