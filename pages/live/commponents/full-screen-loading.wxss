.content.data-v-828d64a6 {
    left: 50%;
    pointer-events: auto;
    position: absolute;
    text-align: center;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%)
}

.content .title.data-v-828d64a6 {
