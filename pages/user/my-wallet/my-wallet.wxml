<view class="index">
    <view class="top_bg" style="{{i}}">
        <view class="ww100" style="{{a}}"></view>
        <view class="tc head_top" style="{{c}}">
            <view bindtap="{{b}}" class="reg180">
                <text class="icon iconfont icon-jiantou"></text>
            </view>
            <view class="fb">我的钱包</view>
        </view>
        <view class="card-top d-b-c" wx:if="{{d}}">
            <view class="flex-1">
                <view class="f28 fb white">账户余额(元)</view>
                <view class="f72 white">
                    <text class="f38">￥</text>
                    <text class="fb">{{e}}</text>
                </view>
            </view>
            <view class="d-c d-c-c" wx:if="{{f}}">
                <view bindtap="{{g}}" class="text-btn mb10">去提现</view>
                <view bindtap="{{h}}" class="white underline f28">提现明细</view>
            </view>
        </view>
    </view>
    <view class="wallet-content" wx:if="{{j}}">
        <view class="index-head" wx:if="{{k}}">
            <view class="card-bottom">
                <view bindtap="{{m}}" class="width-150 font-30 pr flex-1">
                    <view>
                        <image lazyLoad class="wallet_img" mode="" src="{{l}}"></image>
                    </view>
                    <view class="f28 gray3">充值</view>
                </view>
                <view class="none_line"></view>
                <view bindtap="{{o}}" class="width-150 font-30 pr flex-1">
                    <view>
                        <image lazyLoad class="wallet_img" mode="" src="{{n}}"></image>
                    </view>
                    <view class="f28 gray3">充值记录</view>
                </view>
            </view>
        </view>
        <view class="index-body">
            <view class="body-head">
                <view class="name">钱包明细</view>
                <view bindtap="{{p}}" class="more-btn">更多明细<text class="icon iconfont icon-jiantou" style="color:#666;font-size:22rpx"></text>
                </view>
            </view>
            <view style="padding:0 27rpx">
                <view class="body-item" wx:for="{{q}}" wx:key="f">
                    <view class="body-item-top">
                        <view class="body-item-top-left f28">{{item.a}}</view>
                        <view class="body-item-top-right f30" wx:if="{{item.b}}">+{{item.c}}</view>
                        <view class="body-item-top-right f30" wx:else>{{item.d}}</view>
                    </view>
                    <view class="body-item-bottom">
                        <view class="body-item-bottom-left font-24 gray9">{{item.e}}</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
</view>
