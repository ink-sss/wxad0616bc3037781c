wx-label,wx-scroll-view,wx-swiper-item,wx-view {
    -webkit-align-content: flex-start;
    align-content: flex-start;
    -webkit-align-items: stretch;
    align-items: stretch;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-basis: auto;
    flex-basis: auto;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-flex-grow: 0;
    flex-grow: 0;
    -webkit-flex-shrink: 0;
    flex-shrink: 0
}

wx-image,wx-input,wx-scroll-view,wx-swiper,wx-swiper-item,wx-text,wx-textarea,wx-video,wx-view {
    border: 0 solid #000;
    box-sizing: border-box;
    position: relative
}

wx-swiper-item {
    position: absolute
}

wx-button {
    margin: 0
}
