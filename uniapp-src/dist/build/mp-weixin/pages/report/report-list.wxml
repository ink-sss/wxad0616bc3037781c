<view class="report-list data-v-ed516a80"><view class="report-list-head data-v-ed516a80"><text class="page-title data-v-ed516a80">投诉记录</text><view class="new-btn data-v-ed516a80" bindtap="{{a}}">新增投诉</view></view><scroll-view class="list data-v-ed516a80" scroll-y lower-threshold="80" bindscrolltolower="{{f}}"><view wx:for="{{b}}" wx:for-item="item" wx:key="e" class="report-card data-v-ed516a80" bindtap="{{item.f}}"><view class="card-head data-v-ed516a80"><text class="card-title data-v-ed516a80">{{item.a}}</text><text class="status data-v-ed516a80">{{item.b}}</text></view><text class="content data-v-ed516a80">{{item.c}}</text><text class="time data-v-ed516a80">{{item.d}}</text></view><view wx:if="{{c}}" class="state data-v-ed516a80">加载中...</view><view wx:elif="{{d}}" class="state data-v-ed516a80">暂无投诉记录</view><view wx:elif="{{e}}" class="state data-v-ed516a80">没有更多了</view></scroll-view></view>