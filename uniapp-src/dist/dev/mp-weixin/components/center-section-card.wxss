/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.section-card.data-v-5f745d95 {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}
.section-card-order.data-v-5f745d95 {
  padding: 28rpx 24rpx 26rpx;
}
.section-card-more.data-v-5f745d95 {
  padding: 28rpx 24rpx 10rpx;
}
.section-head.data-v-5f745d95 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title.data-v-5f745d95 {
  font-size: 34rpx;
  color: #1f1f1f;
  font-weight: 600;
}
.section-link.data-v-5f745d95 {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.section-link-text.data-v-5f745d95,
.section-link-arrow.data-v-5f745d95 {
  font-size: 26rpx;
  color: #333937;
}
.section-grid.data-v-5f745d95 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}
.grid-item.data-v-5f745d95 {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.grid-badge.data-v-5f745d95 {
  display: flex;
}
.grid-icon-wrap.data-v-5f745d95 {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-icon.data-v-5f745d95 {
  width: 42rpx;
  height: 42rpx;
}
.grid-text.data-v-5f745d95 {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333937;
  text-align: center;
  line-height: 36rpx;
}

/* 更多功能区：4 列 + 大图标 */
.section-card-more .section-grid.data-v-5f745d95 {
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 12rpx;
  margin-top: 30rpx;
}
.section-card-more .grid-icon-wrap.data-v-5f745d95 {
  width: 80rpx;
  height: 80rpx;
}
.section-card-more .grid-icon.data-v-5f745d95 {
  width: 42rpx;
  height: 42rpx;
}
.section-card-more .grid-text.data-v-5f745d95 {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #333937;
}
.section-list.data-v-5f745d95 {
  margin-top: 18rpx;
}
.list-item.data-v-5f745d95 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
}
.list-item-border.data-v-5f745d95 {
  border-top: 1rpx solid #f3f3f3;
}
.list-left.data-v-5f745d95 {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.list-icon.data-v-5f745d95 {
  width: 32rpx;
  height: 32rpx;
}
.list-text.data-v-5f745d95 {
  font-size: 30rpx;
  color: #4a4a4a;
}
.list-arrow.data-v-5f745d95 {
  width: 24rpx;
  height: 24rpx;
}