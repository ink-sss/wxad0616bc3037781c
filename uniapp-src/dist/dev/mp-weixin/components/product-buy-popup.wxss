/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.buy-popup.data-v-b467b6d1 {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 750rpx;
  height: 84vh;
  box-sizing: border-box;
  background: #fff;
}
.section-row.data-v-b467b6d1 {
  padding: 34rpx 32rpx;
}
.address-section.data-v-b467b6d1 {
  padding: 24rpx 32rpx 26rpx;
  border-top: 20rpx solid #f0f4f7;
}
.address-card.data-v-b467b6d1 {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  color: #333;
}
.address-icon.data-v-b467b6d1 {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.address-main.data-v-b467b6d1 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.address-arrow.data-v-b467b6d1 {
  width: 13rpx;
  height: 23rpx;
  flex-shrink: 0;
}

/* 商品信息 */
.product-info.data-v-b467b6d1 {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  gap: 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f2f2;
  flex-shrink: 0;
}
.info-img.data-v-b467b6d1 {
  width: 180rpx;
  min-width: 180rpx;
  max-width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  overflow: hidden;
}
.info-detail.data-v-b467b6d1 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  max-width: 100%;
}
.info-title.data-v-b467b6d1 {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  padding-right: 12rpx;
}
.info-price-row.data-v-b467b6d1 {
  display: flex;
  align-items: baseline;
  font-family: "PingFang SC";
}
.info-price-symbol.data-v-b467b6d1 {
  font-size: 24rpx;
  color: #ff4d4f;
  font-weight: 600;
}
.info-price.data-v-b467b6d1 {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: 700;
}

/* 购买数量 */
.quantity-row.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 32rpx;
  border-top: 20rpx solid #f0f4f7;
}
.section-left.data-v-b467b6d1 {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.section-label.data-v-b467b6d1 {
  font-size: 28rpx;
  color: #1a1a1a;
}
.stock-text.data-v-b467b6d1 {
  font-size: 24rpx;
  color: #999;
}
.quantity-ctrl.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.qty-btn.data-v-b467b6d1 {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qty-btn.disabled.data-v-b467b6d1 {
  opacity: 0.35;
}
.qty-icon-img.data-v-b467b6d1 {
  width: 44rpx;
  height: 44rpx;
}
.qty-num.data-v-b467b6d1 {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
  min-width: 60rpx;
  text-align: center;
}

/* 商品规格 */
.spec-section.data-v-b467b6d1 {
  padding: 0 32rpx 34rpx;
}
.spec-list.data-v-b467b6d1 {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}
.spec-tag.data-v-b467b6d1 {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef1f4;
}
.spec-group.data-v-b467b6d1 {
  margin-bottom: 24rpx;
}
.spec-active.data-v-b467b6d1 {
  background: #ffece5;
  border: 1rpx solid #ff7a1a;
}
.spec-soldout.data-v-b467b6d1 {
  opacity: 0.38;
  position: relative;
  overflow: hidden;
}
.spec-text.data-v-b467b6d1 {
  font-size: 26rpx;
  color: #333;
}
.spec-text-active.data-v-b467b6d1 {
  color: #333;
  font-weight: 400;
}
.spec-text-soldout.data-v-b467b6d1 {
  color: #999;
}
.info-price-range.data-v-b467b6d1 {
  font-size: 24rpx;
  color: #ff4d4f;
  font-weight: 400;
  margin-left: 4rpx;
  align-self: flex-end;
  padding-bottom: 4rpx;
}

/* 备注 */
.remark-row.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.remark-input.data-v-b467b6d1 {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  color: #999;
}
.coupon-row.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.coupon-row-left.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 16rpx;
}
.max-discount.data-v-b467b6d1 {
  max-width: 180rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: rgba(250, 119, 20, 0.06);
  color: #fa7714;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coupon-select-right.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}
.coupon-select-text.data-v-b467b6d1 {
  min-width: 0;
  color: #ff4d4f;
  font-size: 28rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coupon-empty.data-v-b467b6d1 {
  color: #999;
}
.coupon-arrow.data-v-b467b6d1 {
  width: 13rpx;
  height: 23rpx;
  flex-shrink: 0;
}

/* 价格 */
.price-row.data-v-b467b6d1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx 32rpx;
}
.price-label.data-v-b467b6d1 {
  font-size: 28rpx;
  color: #1a1a1a;
}
.price-value.data-v-b467b6d1 {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  font-family: "PingFang SC";
  color: #111;
}
.price-discount.data-v-b467b6d1 {
  color: #ff4d4f;
}

/* 底部按钮 */
.popup-footer.data-v-b467b6d1 {
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  flex-shrink: 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #fff;
}
.popup-pay-left.data-v-b467b6d1 {
  display: flex;
  align-items: baseline;
}
.popup-pay-label.data-v-b467b6d1 {
  font-size: 28rpx;
  color: #555;
}
.popup-pay-price.data-v-b467b6d1 {
  font-family: "PingFang SC";
  margin-left: 12rpx;
  font-size: 46rpx;
  color: #ff180e;
  font-weight: 600;
}
.confirm-btn.data-v-b467b6d1 {
  width: 260rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #ff8a21 0%, #ff5a2e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.confirm-btn-disabled.data-v-b467b6d1 {
  background: #d9d9d9;
}
.confirm-text.data-v-b467b6d1 {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.selected-tip.data-v-b467b6d1 {
  font-size: 24rpx;
  color: #999;
}
.popup-scroll.data-v-b467b6d1 {
  flex: 1;
  min-height: 0;
}