.complaint-img-item__img.data-v-1070d14d {
  width: 100%;
  height: 100%;
}
.complaint-img-item__uploading.data-v-1070d14d {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 24rpx;
}
.complaint-img-item__del.data-v-1070d14d {
