/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.complaint-popup.data-v-1070d14d {
  height: 100%;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.complaint-popup--type.data-v-1070d14d {
  height: auto;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.complaint-popup__header.data-v-1070d14d {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  flex-shrink: 0;
}
.complaint-popup__header--center.data-v-1070d14d {
  justify-content: center;
  position: relative;
  padding-bottom: 28rpx;
}
.complaint-popup__title.data-v-1070d14d {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
}
.complaint-popup__close.data-v-1070d14d {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.complaint-popup__header--center .complaint-popup__close.data-v-1070d14d {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}
.complaint-popup__close-text.data-v-1070d14d {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.38);
}
.complaint-popup__scroll.data-v-1070d14d {
  flex: 1;
  min-height: 0;
}
.complaint-type-grid.data-v-1070d14d {
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx 18rpx;
}
.complaint-type-chip.data-v-1070d14d {
  min-height: 68rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ececec;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}
.complaint-type-chip--active.data-v-1070d14d {
  border-color: var(--wot-color-theme, #ff8a1f);
  background: rgba(255, 138, 31, 0.08);
}
.complaint-type-chip__label.data-v-1070d14d {
  text-align: center;
  font-size: 25rpx;
  line-height: 1.35;
  color: #333;
}
.complaint-popup--form.data-v-1070d14d {
  position: relative;
}
.complaint-popup--success.data-v-1070d14d {
  justify-content: flex-start;
}
.complaint-form-scroll.data-v-1070d14d {
  box-sizing: border-box;
}
.complaint-form-card.data-v-1070d14d {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.complaint-section-title.data-v-1070d14d {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 32rpx 16rpx;
}
.complaint-section-title__req.data-v-1070d14d {
  color: #ff4d4f;
  font-size: 28rpx;
}
.complaint-section-title__text.data-v-1070d14d {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.88);
}
.complaint-live-card.data-v-1070d14d {
  margin: 0 32rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
