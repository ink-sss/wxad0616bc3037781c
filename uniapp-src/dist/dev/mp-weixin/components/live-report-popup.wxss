  align-items: center;
  justify-content: center;
}
.complaint-success__title.data-v-1070d14d {
  margin-top: 26rpx;
  font-size: 34rpx;
  color: #000;
  font-weight: 600;
}
.complaint-success__desc.data-v-1070d14d {
