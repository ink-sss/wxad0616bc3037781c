  background: #f8f8f8;
  border-radius: 16rpx;
  overflow: hidden;
}
.report-desc-textarea.data-v-1070d14d {
  padding: 0 !important;
  margin: 0 !important;
  box-shadow: none !important;
  border: none !important;
  background: #f8f8f8 !important;
}
.complaint-field-error.data-v-1070d14d {
