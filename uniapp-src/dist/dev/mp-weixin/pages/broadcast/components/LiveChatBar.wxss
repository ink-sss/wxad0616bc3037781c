/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
/* 底部栏主体（包裹快捷回复 + 输入行） */
.bottom-bar-main.data-v-ec9f674a {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 12rpx;
}
.bottom-bar-input-row.data-v-ec9f674a {
  display: flex;
  align-items: center;
}

/* 快捷回复横滑条 */
.quick-replies-bar.data-v-ec9f674a {
  width: 100%;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.quick-replies-inner.data-v-ec9f674a {
  display: inline-flex;
  gap: 12rpx;
  padding: 10rpx 0 8rpx;
}
.quick-reply-tag.data-v-ec9f674a {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx 0 24rpx;
  height: 56rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.quick-reply-text.data-v-ec9f674a {
  line-height: 1.2;
  white-space: nowrap;
  word-break: keep-all;
  overflow: hidden;
}
.quick-reply-eye.data-v-ec9f674a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 4rpx;
  padding: 0 4rpx;
}
.quick-reply-popover.data-v-ec9f674a {
  position: absolute;
  left: var(--popover-left, 24rpx);
  bottom: calc(100% + 12rpx);
  padding: 18rpx 22rpx;
  background: #fff;
  color: #333;
  font-size: 26rpx;
  line-height: 1.5;
  border-radius: 16rpx;
  white-space: normal;
  word-break: break-all;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
  z-index: 30;
  box-sizing: border-box;
  width: -moz-max-content;
  width: max-content;
  max-width: calc(100% - 48rpx);
}
.quick-reply-popover__arrow.data-v-ec9f674a {
  position: absolute;
  top: 100%;
  left: clamp(12rpx, var(--arrow-left, 50%), 100% - 12rpx);
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border: 12rpx solid transparent;
  border-top-color: #fff;
}
.bottom-bar--portrait .quick-reply-tag.data-v-ec9f674a {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}
.bottom-bar--landscape .quick-reply-tag.data-v-ec9f674a {
  background: #f0f0f4;
  color: #333;
}

/* 点赞动画 */
.like-btn-wrap.data-v-ec9f674a {
  position: relative;
}
.sectionli.data-v-ec9f674a {
  position: relative;
  display: block;
}
.sectionli .sectionliImg.data-v-ec9f674a {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 100%;
  height: 100%;
  text-align: center;
}
.sectionli .sectionliImg .clickXin.data-v-ec9f674a {
  width: 100%;
  height: 100%;
}
.like-number.data-v-ec9f674a {
  position: absolute;
  left: 50%;
  top: -18rpx;
  z-index: 5;
  min-width: 48rpx;
  height: 26rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: rgba(254, 74, 110, 0.8);
  color: #fff;
  font-size: 20rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
  transform: translateX(-50%);
  box-sizing: border-box;
}
.like-anim-area.data-v-ec9f674a {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 520rpx;
  pointer-events: none;
  overflow: hidden;
  z-index: 19;
}
.float-heart.data-v-ec9f674a {
  position: absolute;
  bottom: 0;
  animation: floatUp-ec9f674a linear forwards;
  opacity: 1;
  will-change: transform, opacity;
}
@keyframes floatUp-ec9f674a {
0% {
    transform: translateY(0) scale(1);
    opacity: 1;
}
30% {
    transform: translateY(-130rpx) scale(1.3);
    opacity: 1;
}
60% {
    transform: translateY(-280rpx) scale(1.3);
    opacity: 0.95;
}
85% {
    transform: translateY(-410rpx) scale(1.3);
    opacity: 0.6;
}
100% {
    transform: translateY(-480rpx) scale(1.3);
    opacity: 0;
}
}
.heart-emoji-img.data-v-ec9f674a {
  width: 64rpx;
  height: 64rpx;
}

/* 底部工具栏 */
.bottom-bar.data-v-ec9f674a {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 10;
  box-sizing: border-box;
}
.toolbar-icons.data-v-ec9f674a {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.send-btn.data-v-ec9f674a {
  min-width: 132rpx;
  height: 74rpx;
  padding: 0 30rpx;
  border-radius: 37rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 6rpx;
  box-sizing: border-box;
  background: #ff6e2d;
  color: #fff;
}
.tool-icon-img.data-v-ec9f674a {
  width: 42rpx;
  height: 42rpx;
}
.tool-sign-text.data-v-ec9f674a {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}
.tool-btn-raw.data-v-ec9f674a {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.tool-share-img.data-v-ec9f674a {
  width: 74rpx;
  height: 74rpx;
}
.goods-box.data-v-ec9f674a {
  position: relative;
  top: 4rpx;
  width: 80rpx;
  height: 80rpx;
  margin-top: -12rpx;
  flex: 0 0 80rpx;
  background-image: url("data:image/png;base64,");
  background-repeat: no-repeat;
  background-size: contain;
  color: #fff;
  cursor: pointer;
}
.goodsNumber.data-v-ec9f674a {
  position: absolute;
  top: 32%;
  left: 56%;
  transform: translate(-50%, 0);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
.invite-icon-btn.data-v-ec9f674a {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.invite-icon-img.data-v-ec9f674a {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

/* ===== 禁用态输入框 ===== */
.input-disabled.data-v-ec9f674a {
  opacity: 0.5;
  pointer-events: none;
}

