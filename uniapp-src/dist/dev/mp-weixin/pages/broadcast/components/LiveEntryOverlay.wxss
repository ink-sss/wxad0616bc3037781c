/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
/* ===== 进入直播间蒙层 ===== */
.entry-overlay-content.data-v-fcf21325 {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-btn.data-v-fcf21325 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 60rpx;
  padding: 20rpx 48rpx;
}
.entry-btn-text.data-v-fcf21325 {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.bars-anim.data-v-fcf21325 {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 36rpx;
}
.bar.data-v-fcf21325 {
  width: 6rpx;
  border-radius: 3rpx;
  background: #fff;
  animation: barBounce-fcf21325 0.8s ease-in-out infinite alternate;
}
.bar1.data-v-fcf21325 {
  height: 20rpx;
  animation-delay: 0s;
}
.bar2.data-v-fcf21325 {
  height: 32rpx;
  animation-delay: 0.2s;
}
.bar3.data-v-fcf21325 {
  height: 20rpx;
  animation-delay: 0.4s;
}
@keyframes barBounce-fcf21325 {
0% {
    transform: scaleY(0.4);
}
100% {
    transform: scaleY(1);
}
}