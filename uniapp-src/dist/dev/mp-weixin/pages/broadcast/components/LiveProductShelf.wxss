/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.product-area.data-v-4b3ce6ac {
  position: absolute;
  right: 32rpx;
  bottom: calc(190rpx + env(safe-area-inset-bottom));
  z-index: 9;
}

/* 竖屏商品列表弹窗 */
.product-list-mask.data-v-4b3ce6ac {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
}
.product-list-popup.data-v-4b3ce6ac {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.9);
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  -webkit-overflow-scrolling: touch;
  height: 75%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.popup-header.data-v-4b3ce6ac {
  color: #666666;
  padding: 0 32rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 88rpx;
}
.popup-title.data-v-4b3ce6ac {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}
.goods-all-box.data-v-4b3ce6ac {
  height: 100%;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  background-color: #fff;
  padding: 20rpx 0rpx;
  padding-bottom: env(safe-area-inset-bottom);
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
}
.goods-all-box.data-v-4b3ce6ac .goods-content {
  width: 100%;
  margin: 0 auto;
  height: 100%;
  overflow-y: auto;
}
.goods-all-box.data-v-4b3ce6ac .product-scroll {
  height: 100%;
}
.product-success-notice.data-v-4b3ce6ac {
  position: absolute;
  bottom: calc(75% + 20rpx);
  left: 36rpx;
  z-index: 3;
  overflow: hidden;
}
.goods-bullet-chat .list-bullet-item.data-v-4b3ce6ac {
  height: 100%;
  max-width: 466rpx;
  padding: 4rpx 8rpx 4rpx 4rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  color: #fff;
  transition: all 200ms ease-in-out;
  overflow: hidden;
  line-height: 32rpx;
}
.goods-bullet-chat .list-bullet-item.entering.data-v-4b3ce6ac {
  opacity: 0;
  transform: translateY(72rpx);
}
.goods-bullet-chat .list-bullet-item.entered.data-v-4b3ce6ac {
  opacity: 1;
  transform: translateY(0);
}
.goods-bullet-chat .list-bullet-item.exiting.data-v-4b3ce6ac {
  opacity: 0;
  transform: translateY(-72rpx);
}
.goods-bullet-chat .list-bullet-goods-img.data-v-4b3ce6ac {
  position: relative;
}
.goods-bullet-chat .list-bullet-goods-sort.data-v-4b3ce6ac {
  position: absolute;
  top: 0;
  left: 0;
  width: 32rpx;
  height: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 12rpx 0 12rpx 0;
  overflow: hidden;
  text-align: center;
  font-size: 18rpx;
  line-height: 26rpx;
  color: #fff;
  font-weight: bold;
}
.goods-bullet-chat .list-bullet-goods-img.data-v-4b3ce6ac,
.goods-bullet-chat .buy-img.data-v-4b3ce6ac {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.goods-bullet-chat .buy-content.data-v-4b3ce6ac {
  min-width: 0;
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
}
.goods-bullet-chat .buy-title.data-v-4b3ce6ac {
  color: #e0e0e0;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.goods-bullet-chat .buy-goods-name.data-v-4b3ce6ac {
  max-width: 274rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.goods-bullet-chat .buy-btn.data-v-4b3ce6ac {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 48rpx;
  margin-left: 8rpx;
  background: linear-gradient(270deg, #ff0e4c 0%, #ff6089 100%);
  border-radius: 32rpx;
  font-weight: 600;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

/* 商品弹窗 (横屏单品) */
.product-popup.data-v-4b3ce6ac {
  position: relative;
  pointer-events: auto;
}
.landscape-product-anchor.data-v-4b3ce6ac {
  position: absolute;
  right: 32rpx;
  bottom: calc(100% + 12rpx);
  pointer-events: none;
}
.landscape-product-anchor .product-popup.data-v-4b3ce6ac {
  pointer-events: auto;
}
/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
/* 竖屏商品列表弹窗动画（与规格弹窗一致） */
.plist-popup-enter {
  transform: translateY(100%) !important;
}
.plist-popup-enter-active {
  transition: transform 500ms ease-out !important;
}
.plist-popup-enter-to {
  transform: translateY(0) !important;
}
.plist-popup-leave {
  transform: translateY(0) !important;
}
.plist-popup-leave-active {
  transition: transform 400ms ease-in !important;
}
.plist-popup-leave-to {
  transform: translateY(100%) !important;
}