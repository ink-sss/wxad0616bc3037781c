/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.pay-page.data-v-faef4742 {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 状态头部 ===== */
.status-header.data-v-faef4742 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 48rpx;
  color: #fff;
}
.header-loading.data-v-faef4742 {
  background: linear-gradient(135deg, #ff8a1d 0%, #ff6b10 100%);
}
.header-success.data-v-faef4742 {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}
.header-fail.data-v-faef4742 {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
}
.status-icon-wrap.data-v-faef4742 {
  margin-bottom: 20rpx;
}
.spinner.data-v-faef4742 {
  width: 72rpx;
  height: 72rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin-faef4742 0.8s linear infinite;
}
@keyframes spin-faef4742 {
to {
    transform: rotate(360deg);
}
}
.icon-circle.data-v-faef4742 {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: iconPop-faef4742 0.35s ease-out;
}
@keyframes iconPop-faef4742 {
0% {
    transform: scale(0.5);
    opacity: 0;
}
100% {
    transform: scale(1);
    opacity: 1;
}
}
.icon-success.data-v-faef4742,
.icon-fail.data-v-faef4742 {
  background: rgba(255, 255, 255, 0.25);
}
.check-mark.data-v-faef4742 {
  width: 32rpx;
  height: 20rpx;
  border-left: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}
.fail-mark.data-v-faef4742 {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.fail-line.data-v-faef4742 {
  position: absolute;
  width: 36rpx;
  height: 5rpx;
  background: #fff;
  border-radius: 3rpx;
  top: 50%;
  left: 0;
  margin-top: -2.5rpx;
}
.fail-line-1.data-v-faef4742 {
  transform: rotate(45deg);
}
.fail-line-2.data-v-faef4742 {
  transform: rotate(-45deg);
}
.status-title.data-v-faef4742 {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.status-hint.data-v-faef4742 {
  font-size: 24rpx;
  opacity: 0.8;
}

/* ===== 详情区域 ===== */
.detail-section.data-v-faef4742 {
  padding: 24rpx 24rpx 0;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}
.card.data-v-faef4742 {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* ===== 商品卡片 ===== */
.goods-card.data-v-faef4742 {
  padding: 24rpx;
}
.goods-row.data-v-faef4742 {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}
.goods-row + .goods-row.data-v-faef4742 {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 12rpx;
  padding-top: 24rpx;
}
.goods-img.data-v-faef4742 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}
.goods-img-placeholder.data-v-faef4742 {
  background: #eee;
}
.goods-info.data-v-faef4742 {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-height: 140rpx;
}
.goods-name.data-v-faef4742 {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.goods-sku.data-v-faef4742 {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
  align-self: flex-start;
}
.goods-bottom.data-v-faef4742 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}
.goods-price.data-v-faef4742 {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff5722;
}
.goods-qty.data-v-faef4742 {
  font-size: 24rpx;
  color: #999;
}

/* ===== 金额卡片 ===== */
.amount-card.data-v-faef4742 {
  padding: 24rpx 28rpx;
}
.amount-row.data-v-faef4742 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.amount-label.data-v-faef4742 {
  font-size: 26rpx;
  color: #666;
}
.amount-value.data-v-faef4742 {
  font-size: 26rpx;
  color: #333;
}
.amount-mono.data-v-faef4742 {
  font-family: monospace;
  font-size: 24rpx;
  color: #999;
}
.discount-text.data-v-faef4742 {
  color: #ff5722;
}
.amount-divider.data-v-faef4742 {
  height: 1rpx;
  background: #f0f0f0;
  margin: 8rpx 0;
}
.amount-total-row.data-v-faef4742 {
  padding-top: 16rpx;
}
.total-label.data-v-faef4742 {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.total-value.data-v-faef4742 {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5722;
}

/* ===== 地址卡片 ===== */
.address-card.data-v-faef4742 {
  padding: 24rpx 28rpx;
}
.addr-row.data-v-faef4742 {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.addr-name.data-v-faef4742 {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.addr-phone.data-v-faef4742 {
  font-size: 26rpx;
  color: #666;
}
.addr-detail.data-v-faef4742 {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* ===== 底部按钮栏 ===== */
.bottom-bar.data-v-faef4742 {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}
.bottom-inner.data-v-faef4742 {
  display: flex;
  gap: 20rpx;
}
.bottom-inner-dual .pay-btn.data-v-faef4742,
.bottom-inner-triple .pay-btn.data-v-faef4742 {
  flex: 1;
}
.pay-btn.data-v-faef4742 {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: opacity 0.2s;
}
.pay-btn.data-v-faef4742:active {
  opacity: 0.8;
}
.pay-btn-primary.data-v-faef4742 {
  background: linear-gradient(90deg, #ff8a1d 0%, #ff7215 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 114, 21, 0.3);
}
.pay-btn-ghost.data-v-faef4742 {
  background: #f5f5f5;
  color: #666;
}
.pay-btn-disabled.data-v-faef4742 {
  background: #f5f5f5;
  color: #999;
}
.btn-spinner.data-v-faef4742 {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #ccc;
  border-top-color: #999;
  border-radius: 50%;
  animation: spin-faef4742 0.8s linear infinite;
}