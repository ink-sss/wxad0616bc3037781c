}
.goods-price.data-v-7adfef09 {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}
.price-label.data-v-7adfef09 {
  font-size: 26rpx;
  color: #666;
  font-weight: 400;
}
.price-symbol.data-v-7adfef09 {
  font-size: 24rpx;
}
.price-int.data-v-7adfef09 {
  font-size: 30rpx;
}
.price-dec.data-v-7adfef09 {
