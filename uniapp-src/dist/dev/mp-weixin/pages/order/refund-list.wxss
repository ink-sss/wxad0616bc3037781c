/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.refund-list-page.data-v-7adfef09 {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}
.refund-list.data-v-7adfef09 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.refund-card.data-v-7adfef09 {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.refund-head.data-v-7adfef09 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.refund-no.data-v-7adfef09 {
  font-size: 24rpx;
  color: #666;
}
.refund-status.data-v-7adfef09 {
  font-size: 24rpx;
  font-weight: 500;
}
.status-muted.data-v-7adfef09 {
  color: #999;
}
.goods-row.data-v-7adfef09 {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.goods-image.data-v-7adfef09 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}
.goods-content.data-v-7adfef09 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.goods-title.data-v-7adfef09 {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}
.goods-meta-row.data-v-7adfef09 {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.goods-spec.data-v-7adfef09 {
  font-size: 28rpx;
  color: #888;
}
.goods-count.data-v-7adfef09 {
  font-size: 28rpx;
  color: #888;
}
.goods-price-row.data-v-7adfef09 {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.refund-tag.data-v-7adfef09 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #fff;
  white-space: nowrap;
  line-height: 1;
  align-self: flex-start;
}
.refund-tag-processing.data-v-7adfef09 {
  color: #fd6119;
  border: 1rpx solid #fd6119;
}
.refund-tag-success.data-v-7adfef09 {
