/* uni-app automatically injects uni.scss into every component style block.
   Keep this file for variables/mixins only; global CSS rules live in
   app-global.scss so they do not become invalid component WXSS selectors. */
.receipt-page.data-v-630cbc0b {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}
.receipt-card.data-v-630cbc0b {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.06);
}
.receipt-header.data-v-630cbc0b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  background: linear-gradient(180deg, #fff1e6 0%, #fff8f3 100%);
}
.receipt-title.data-v-630cbc0b {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}
.receipt-status.data-v-630cbc0b {
  font-size: 28rpx;
  color: #f58d1b;
}
.receipt-section.data-v-630cbc0b {
  padding: 28rpx;
  border-bottom: 1rpx dashed #ececec;
}
.receipt-row.data-v-630cbc0b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-top: 18rpx;
}
.receipt-row.data-v-630cbc0b:first-child {
  margin-top: 0;
}
.receipt-row-top.data-v-630cbc0b {
  align-items: flex-start;
}
.receipt-row-strong .label.data-v-630cbc0b,
.receipt-row-strong .value.data-v-630cbc0b {
  font-size: 32rpx;
  font-weight: 600;
}
.label.data-v-630cbc0b {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #666;
}
.value.data-v-630cbc0b {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #222;
  word-break: break-all;
}
.value-amount.data-v-630cbc0b {
  color: #f58d1b;
}
.goods-row.data-v-630cbc0b {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.goods-image.data-v-630cbc0b {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.goods-info.data-v-630cbc0b {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.goods-title.data-v-630cbc0b {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #222;
}
.goods-spec.data-v-630cbc0b,
.goods-qty.data-v-630cbc0b {
  font-size: 24rpx;
  color: #888;
}
.goods-price.data-v-630cbc0b {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.address-block.data-v-630cbc0b {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.address-text.data-v-630cbc0b {
  line-height: 38rpx;
}
.receipt-footer.data-v-630cbc0b {
  display: flex;
  gap: 20rpx;
  padding: 100rpx 28rpx 28rpx;
}
.receipt-btn.data-v-630cbc0b {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  border: 1rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}
.receipt-btn-primary.data-v-630cbc0b {
  color: #fff;
  border-color: #f58d1b;
  background: linear-gradient(135deg, #ff9f2f 0%, #f58d1b 100%);
}
.receipt-btn-live.data-v-630cbc0b {
  color: #fff;
  border-color: #f58d1b;
  background: linear-gradient(135deg, #ff9f2f 0%, #f58d1b 100%);
}
.receipt-error-title.data-v-630cbc0b {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #e64340;
  margin-bottom: 16rpx;
}
.receipt-error-msg.data-v-630cbc0b {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.receipt-debug.data-v-630cbc0b {
  background: #fafafa;
}