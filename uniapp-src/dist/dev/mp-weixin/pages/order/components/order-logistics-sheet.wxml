<view class="logistics-overlay data-v-b323d6de" bindtap="{{l}}"><view class="logistics-sheet data-v-b323d6de" catchtap="{{k}}"><view class="logistics-header data-v-b323d6de"><text class="logistics-title data-v-b323d6de">物流详情</text><view class="logistics-close data-v-b323d6de" bindtap="{{a}}"><text class="close-x data-v-b323d6de">✕</text></view></view><view wx:if="{{b}}" class="logistics-company-bar data-v-b323d6de"><view class="logistics-company-info data-v-b323d6de"><text class="logistics-company-name data-v-b323d6de">{{c}}</text><view class="{{['logistics-status-tag', 'data-v-b323d6de', e]}}"><text class="logistics-status-text data-v-b323d6de">{{d}}</text></view></view><view class="logistics-tracking-row data-v-b323d6de" bindtap="{{h}}"><text class="logistics-tracking-no data-v-b323d6de">{{f}}</text><image class="copy-icon data-v-b323d6de" src="{{g}}" mode="aspectFit"/></view></view><scroll-view class="logistics-timeline-scroll data-v-b323d6de" scroll-y><view wx:if="{{i}}" class="logistics-empty data-v-b323d6de"><text class="logistics-empty-text data-v-b323d6de">暂无物流轨迹信息</text></view><view wx:else class="logistics-timeline data-v-b323d6de"><view wx:for="{{j}}" wx:for-item="trace" wx:key="f" class="{{['timeline-item', 'data-v-b323d6de', trace.g && 'timeline-item-active']}}"><view class="timeline-dot-col data-v-b323d6de"><view class="{{['timeline-dot', 'data-v-b323d6de', trace.a && 'timeline-dot-active']}}"/><view wx:if="{{trace.b}}" class="timeline-line data-v-b323d6de"/></view><view class="timeline-content data-v-b323d6de"><text class="{{['timeline-text', 'data-v-b323d6de', trace.d && 'timeline-text-active']}}">{{trace.c}}</text><text class="timeline-time data-v-b323d6de">{{trace.e}}</text></view></view></view></scroll-view></view></view>