.recommend-product {
    margin-top: 40rpx
}

.recommend-product .title {
    font-size: 30rpx;
    height: 100rpx
}

.recommend-product .title .name {
    font-size: 30rpx;
    margin: 0 10rpx
}

.recommend-product .title .line {
    border-top: 1px solid red;
    display: block;
    position: relative;
    width: 100rpx
}

.recommend-product .title .line:after {
    background: red;
    border-radius: 50%;
    content: "";
    display: block;
    height: 16rpx;
    position: absolute;
    width: 16rpx
}

.recommend-product .title .left-line:after {
    right: 0;
    top: -9rpx
}

.recommend-product .title .right-line:after {
    left: 0;
    top: -9rpx
}

.recommend-product-list {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 20rpx
}

.recommend-product-list .item {
    background: #fff;
    border-radius: 25rpx;
    box-sizing: border-box;
    margin-bottom: 22rpx;
    min-height: 530rpx;
    overflow: hidden;
    padding-bottom: 20rpx;
    width: 342rpx
}

.recommend-product-list .product-cover {
    height: 342rpx;
    margin-bottom: 10rpx;
    width: 342rpx
}

.recommend-product-list wx-image {
    height: 100%;
    width: 100%
}

.recommend-product-list .product-info {
    padding: 0 22rpx
}

.recommend-product-list .product-title {
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    font-size: 28rpx;
    overflow: hidden
}

.recommend-product-list .price .num {
    font-size: 36rpx;
    font-weight: 700
}

.line-left {
    height: 2rpx;
    width: 60px
}

[data-theme=theme0] .line-left {
    background-color: #ff5704!important
}

[data-theme=theme1] .line-left {
    background-color: #19ad57!important
}

[data-theme=theme2] .line-left {
    background-color: #fc0!important
}

[data-theme=theme3] .line-left {
    background-color: #33a7ff!important
}

[data-theme=theme4] .line-left {
    background-color: #e4e4e4!important
}

[data-theme=theme5] .line-left {
    background-color: #c8ba97!important
}

[data-theme=theme6] .line-left {
    background-color: #623ceb!important
}

.line-right {
    height: 2rpx;
    width: 60px
}

