.diy-article {
    overflow: hidden;
    padding: 0 30rpx
}

.diy-article .show-type__10,.diy-article .show-type__20 {
    border-bottom: 1rpx solid #eee;
    display: -webkit-flex;
    display: flex;
    padding: 30rpx 0
}

.diy-article .show-type__10:last-child,.diy-article .show-type__20:last-child {
    border-bottom: none
}

.diy-article .show-type__10 .picture {
    border-radius: 12rpx;
    height: 140rpx;
    width: 246rpx
}

.diy-article .show-type__10 .title {
    height: 80rpx
}

.diy-article .show-type__10 .des {
    height: 36rpx
}

.diy-article wx-image {
    border-radius: 12rpx;
    height: 100%;
    width: 100%
}

.diy-article .show-type__10 .icon.iconfont {
    color: #999;
    font-size: 18rpx
}
