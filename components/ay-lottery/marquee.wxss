.box-ly-pm {
    border-radius: 25rpx;
    margin: 0 auto;
    position: relative
}

.box-in {
    background-repeat: no-repeat;
    background-size: 100% 100%;
    border-radius: 40rpx;
    bottom: 0;
    left: 0;
    margin: auto;
    right: 0;
    top: 0
}

.box-in,.dot {
    position: absolute
}

.dot {
    border-radius: 50%;
    display: block;
    height: 16rpx;
    width: 16rpx
}

.dot:nth-child(odd) {
    -webkit-animation: odd .5s linear infinite;
    animation: odd .5s linear infinite;
    background: #fff
}

.dot:nth-child(2n) {
    -webkit-animation: even .5s linear infinite;
    animation: even .5s linear infinite;
    background: #fdf1ae
}

