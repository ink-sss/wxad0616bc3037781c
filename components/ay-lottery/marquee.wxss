@-webkit-keyframes odd {
    0% {
        background: #fff;
        box-shadow: 0 3rpx 7rpx rgba(195,117,41,.35),0 3rpx 7rpx hsla(24,69%,92%,.35)
    }

    to {
        background: #ffe211;
        box-shadow: 0 3rpx 7rpx hsla(27,74%,67%,.35),0 3rpx 7rpx rgba(255,226,17,.35)
    }
}

@keyframes odd {
    0% {
        background: #fff;
        box-shadow: 0 3rpx 7rpx rgba(195,117,41,.35),0 3rpx 7rpx hsla(24,69%,92%,.35)
    }

    to {
        background: #ffe211;
        box-shadow: 0 3rpx 7rpx hsla(27,74%,67%,.35),0 3rpx 7rpx rgba(255,226,17,.35)
    }
}

@-webkit-keyframes even {
    0% {
        background: #ffe211;
        box-shadow: 0 3rpx 7rpx hsla(27,74%,67%,.35),0 3rpx 7rpx rgba(255,226,17,.35)
    }

    to {
        background: #fff;
        box-shadow: 0 3rpx 7rpx rgba(195,117,41,.35),0 3rpx 7rpx hsla(24,69%,92%,.35)
    }
}

@keyframes even {
    0% {
        background: #ffe211;
        box-shadow: 0 3rpx 7rpx hsla(27,74%,67%,.35),0 3rpx 7rpx rgba(255,226,17,.35)
    }

    to {
