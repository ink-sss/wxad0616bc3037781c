.countdown .box {
    background: #fff;
    border-radius: 8rpx;
    color: #fff;
    display: inline-block;
    padding: 4rpx;
    text-align: center
}

[data-theme=theme0] .countdown .box {
    background-color: #ff5704!important
}

[data-theme=theme1] .countdown .box {
    background-color: #19ad57!important
}

[data-theme=theme2] .countdown .box {
    background-color: #fc0!important
}

[data-theme=theme3] .countdown .box {
    background-color: #33a7ff!important
}

[data-theme=theme4] .countdown .box {
    background-color: #e4e4e4!important
}

[data-theme=theme5] .countdown .box {
    background-color: #c8ba97!important
}

[data-theme=theme6] .countdown .box {
    background-color: #623ceb!important
}

[data-theme=theme0] .countdown .box,[data-theme=theme1] .countdown .box,[data-theme=theme2] .countdown .box,[data-theme=theme3] .countdown .box,[data-theme=theme4] .countdown .box,[data-theme=theme5] .countdown .box,[data-theme=theme6] .countdown .box {
    color: #fff!important
}
