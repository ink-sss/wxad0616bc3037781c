.load-more {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 80rpx;
    -webkit-justify-content: center;
    justify-content: center
}

.loading-img {
    height: 24px;
    margin-right: 10px;
    width: 24px
}

.loading-text {
    color: #999;
    font-size: 24rpx
}

.loading-img>wx-view {
    position: absolute
}

.load1,.load2,.load3 {
    height: 24px;
    width: 24px
}

.load2 {
    -webkit-transform: rotate(30deg);
    transform: rotate(30deg)
}

.load3 {
    -webkit-transform: rotate(60deg);
    transform: rotate(60deg)
}

.loading-img>wx-view wx-view {
    -webkit-animation: load 1.56s ease infinite;
    background: #777;
    border-bottom-left-radius: 1px;
    border-top-left-radius: 1px;
    height: 2px;
    opacity: .2;
    position: absolute;
    -webkit-transform-origin: 50%;
    transform-origin: 50%;
    width: 6px
}

.loading-img>wx-view wx-view:nth-child(1) {
    left: 9px;
    top: 2px;
    -webkit-transform: rotate(90deg);
    transform: rotate(90deg)
}

.loading-img>wx-view wx-view:nth-child(2) {
    right: 0;
    top: 11px;
    -webkit-transform: rotate(180deg)
}

.loading-img>wx-view wx-view:nth-child(3) {
    bottom: 2px;
    left: 9px;
    -webkit-transform: rotate(270deg);
    transform: rotate(270deg)
}

.loading-img>wx-view wx-view:nth-child(4) {
    left: 0;
    top: 11px
}

.load1 wx-view:nth-child(1) {
    -webkit-animation-delay: 0s;
    animation-delay: 0s
}

.load2 wx-view:nth-child(1) {
    -webkit-animation-delay: .13s;
    animation-delay: .13s
}

.load3 wx-view:nth-child(1) {
    -webkit-animation-delay: .26s;
    animation-delay: .26s
}

.load1 wx-view:nth-child(2) {
    -webkit-animation-delay: .39s;
    animation-delay: .39s
}

.load2 wx-view:nth-child(2) {
    -webkit-animation-delay: .52s;
    animation-delay: .52s
}

.load3 wx-view:nth-child(2) {
    -webkit-animation-delay: .65s;
    animation-delay: .65s
}

.load1 wx-view:nth-child(3) {
    -webkit-animation-delay: .78s;
    animation-delay: .78s
}

.load2 wx-view:nth-child(3) {
    -webkit-animation-delay: .91s;
    animation-delay: .91s
}

.load3 wx-view:nth-child(3) {
    -webkit-animation-delay: 1.04s;
    animation-delay: 1.04s
}

.load1 wx-view:nth-child(4) {
    -webkit-animation-delay: 1.17s;
    animation-delay: 1.17s
}

.load2 wx-view:nth-child(4) {
    -webkit-animation-delay: 1.3s;
    animation-delay: 1.3s
}

.load3 wx-view:nth-child(4) {
    -webkit-animation-delay: 1.43s;
    animation-delay: 1.43s
}
